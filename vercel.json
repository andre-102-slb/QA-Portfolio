{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/report/:runId/:file(.*)",
      "destination": "/api/report?run_id=:runId&file=:file"
    },
    {
      "source": "/api/report/:runId",
      "destination": "/api/report?run_id=:runId"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/report.ts": {
      "maxDuration": 60
    }
  }
}
